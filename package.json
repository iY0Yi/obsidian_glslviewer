{
	"name": "obsidian-glsl-viewer",
	"version": "0.1.5",
	"description": "A plugin to preview GLSL shaders in Obsidian notes with WebGL rendering",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs development",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint \"main.ts\" \"src/**/*.ts\""
	},
	"keywords": [
		"obsidian",
		"plugin",
		"glsl",
		"shader",
		"webgl"
	],
	"author": "iY0Yi",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^16.11.6",
		"@typescript-eslint/eslint-plugin": "^8.46.0",
		"@typescript-eslint/parser": "^8.46.0",
		"builtin-modules": "3.3.0",
		"esbuild": "0.17.3",
		"eslint": "^9.39.1",
		"eslint-plugin-obsidianmd": "^0.1.8",
		"globals": "^16.5.0",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "^5.9.3"
	}
}
